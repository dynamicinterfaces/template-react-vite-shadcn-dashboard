{
  "appRoot": "",
  "framework": "react",
  "packageManager": "npm",
  "installCommand": "",
  "devCommand": "npx vite --host 0.0.0.0 --port 5173",
  "devPort": 5173,
  "buildCommand": "npm run build",
  "buildOutputDir": "dist",
  "previewStrategy": "none",
  "env": {},
  "routes": [
    {
      "path": "src/features/posts/index.tsx",
      "route": "/",
      "name": "Posts"
    },
    {
      "path": "src/features/posts/detail/index.tsx",
      "route": "/post/:postId",
      "name": "Post Detail"
    },
    {
      "path": "src/features/payment/index.tsx",
      "route": "/payment",
      "name": "Payment"
    },
    {
      "path": "src/features/kanban/index.tsx",
      "route": "/kanban",
      "name": "Kanban"
    },
    {
      "path": "src/features/kanban/create/index.tsx",
      "route": "/kanban/create",
      "name": "Kanban Create"
    },
    {
      "path": "src/features/kanban/detail/index.tsx",
      "route": "/kanban/detail/:id",
      "name": "Kanban Detail"
    },
    {
      "path": "src/features/kanban/edit/index.tsx",
      "route": "/kanban/edit/:id",
      "name": "Kanban Edit"
    },
    {
      "path": "src/features/authentication/login.tsx",
      "route": "/login",
      "name": "Login"
    },
    {
      "path": "src/features/authentication/register.tsx",
      "route": "/register",
      "name": "Register"
    },
    {
      "path": "src/pages/GoogleCallbackPage.tsx",
      "route": "/auth/google/callback",
      "name": "Google Callback"
    },
    {
      "path": "src/pages/WelcomePage.tsx",
      "route": "/welcome",
      "name": "Welcome"
    }
  ],
  "gitBranch": "",
  "gitRemote": "",
  "layout": {
    "cols": 3,
    "colWidth": 340,
    "rowHeight": 400,
    "offsetX": 450,
    "offsetY": 0
  },
  "defaultDimensions": {
    "width": 300,
    "height": 350
  }
}